{
  // Agent-scoped hooks run the agent-guard (.github/agent-guard). Preview; Local harness only.
  "chat.useHooks": true,
  "chat.useCustomAgentHooks": true,

  // Load AGENTS.md from the repo root as instructions.
  "chat.useAgentsMdFile": true,

  // Auto-approve the quality-gate commands so a long run doesn't stop before every command.
  // The agent-guard still denies anything outside each agent's policy.
  // Setting names can change between VS Code versions — check Settings if a key shows as unknown.
  "chat.tools.terminal.autoApprove": {
    "npm run typecheck": true,
    "npm run lint": true,
    "npm test": true,
    "npm run test": true,
    "npm run coverage": true,
    "npm run build": true,
    "npm run build-storybook": true,
    "npm run e2e": true,
    "npx vitest run": true,
    "git status": true,
    "git diff": true,
    "git log": true,
    "git rev-parse": true,
    "git push": false,
    "rm": false
  }
}
